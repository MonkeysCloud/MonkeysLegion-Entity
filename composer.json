{
    "name": "monkeyscloud/monkeyslegion-entity",
    "description": "Attribute-based data-mapper, entity scanner, hydration, and metadata layer for MonkeysLegion v2.",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "MonkeysLegion\\Entity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MonkeysLegion\\Entity\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev",
            "dev-2.x-dev": "2.0.x-dev"
        }
    }
}